# Ingress. One hostname: there is no admin origin, because there is no admin surface.
PUBLIC_ORIGIN=https://anonshock.namelessnanashi.dev
TRUST_PROXY=cloudflare
TUNNEL_TOKEN=
# docker-compose.yml sets SOCKET_PATH to a shared Unix socket. Production
# startup refuses to bind a plaintext TCP listener.

# Upstream OpenShock. Change for api.openshock.dev or a self-hosted instance.
UPSTREAM_BASE=https://api.openshock.app
# The User-Agent is AnonShock/<version> (+<PUBLIC_ORIGIN>).
APP_VERSION=0.0.1
UPSTREAM_TIMEOUT_MS=5000

# Source disclosure. Any modified deployment exposed to the open internet must
# set IS_FORK=true and replace this URL with its public source repository.
IS_FORK=false
GIT_REPO_URL=https://github.com/NanashiTheNameless/AnonShock

# Store. Link definitions only: no logs, no sessions, no history.
DB_PATH=/data/anonshock.db

# Secrets. Generate each with: openssl rand -base64 32
# STORE_KEY seals upstream identifiers and API tokens in the store.
# Losing it makes every stored link unreadable, which is data loss, not a breach.
STORE_KEY=
TOKEN_PEPPER=

# There is no request log at any level. error | off
LOG_LEVEL=error

HOLDER_COOKIE_DAYS=90
MAX_LINK_TTL_SECONDS=604800
ROOM_IDLE_TTL_SECONDS=3600

MAX_ROOMS=500
MAX_LINKS=2000
MAX_LINKS_PER_HOLDER=20
MAX_LINKS_PER_IP_PER_DAY=10
MAX_SESSIONS_PER_IP_PER_10MIN=5

# Instance ceilings. No link may exceed these, whatever its creator sets.
INSTANCE_MAX_INTENSITY=100
INSTANCE_MAX_DURATION=30000

# Token mode puts a real OpenShock credential in this instance's store.
# Reasonable on a single-owner box, questionable on a shared one.
ALLOW_TOKEN_MODE=true

# Bot check. ALTCHA is proof of work, issued and verified by this instance, with
# the official widget served from public/vendor: no third party is contacted.
# Leave the key empty to disable the check entirely.
# Generate with: openssl rand -base64 32
ALTCHA_HMAC_KEY=
# PBKDF2 iterations per attempt
ALTCHA_COST=10000
ALTCHA_EXPIRY_SECONDS=300
